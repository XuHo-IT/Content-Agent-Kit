# Secrets — NEVER commit
.env
.env.local
.env.*.local

# Agent state / ledger / dedup (regenerated at runtime)
state/*.json
!state/*.example.json
**/queue.json
**/ledger.json
**/history.json
**/posted_history.json
**/daily_posts_queue.json
**/long_in_progress.json
suutam_raw.json
audit_input.json

# Per-run scratch + generated assets + brain reports
scratch/
brain/
output/
*.log

# Video: rendered artifacts + the SFX library (fetched with scripts/video/sfx-*.mjs).
# video-templates/ IS committed — it is the kit's template library.
assets/sfx/
assets/sfx-raw/
**/video.mp4
**/video-silent.mp4
**/voice.mp3
**/voice-raw.mp3
**/clips/
**/voice/

# Downloaded B-roll and screenshots — these land next to the script.json that uses them.
# media-lock.json is deliberately NOT ignored: it is what makes a render reproducible, and
# it is the record of where every clip came from.
#
# ⚠️ A bare `**/media/` also swallows `scripts/media/` — the SOURCE directory for the whole
# media layer. It did exactly that once: nine files were silently left out of a commit and
# CI failed on every Node version because render.mjs could not import them. Keep the
# negations, and keep them in this order (git cannot re-include a file whose parent
# directory is still excluded, so the directory has to be un-ignored first).
**/media/
!scripts/media/
!scripts/media/**
!**/media-lock.json
stock-sources.yaml

# Python / Node
__pycache__/
*.pyc
.venv/
node_modules/

# OS
.DS_Store
Thumbs.db
