# Secrets — NEVER commit
.env
.env.local
.env.*.local

# Agent state / ledger / dedup (regenerated at runtime)
state/*.json
!state/*.example.json
**/queue.json
**/ledger.json
**/history.json
**/posted_history.json
**/daily_posts_queue.json
**/long_in_progress.json
suutam_raw.json
audit_input.json

# Per-run scratch + generated assets + brain reports
scratch/
brain/
output/
*.log

# Built geo flythrough clips, cached by request hash so a re-render is not re-billed
# (scripts/media/lib/sources/geo.mjs). Regenerated on demand; costs cents, not nothing.
.cache/

# Video: rendered artifacts + the SFX library (fetched with scripts/video/sfx-*.mjs).
# video-templates/ IS committed — it is the kit's template library.
assets/sfx/
assets/sfx-raw/
# Vision models (YuNet, selfie segmenter) — fetched on first use, pinned by sha256 (scripts/video/lib/vision.mjs)
assets/models/
**/video.mp4
**/video-silent.mp4
**/voice.mp3
**/voice-raw.mp3
**/clips/
**/voice/

# Downloaded B-roll and screenshots — these land next to the script.json that uses them.
# media-lock.json is deliberately NOT ignored: it is what makes a render reproducible, and
# it is the record of where every clip came from.
#
# ⚠️ A bare `**/media/` also swallows `scripts/media/` — the SOURCE directory for the whole
# media layer. It did exactly that once: nine files were silently left out of a commit and
# CI failed on every Node version because render.mjs could not import them. Keep the
# negations, and keep them in this order (git cannot re-include a file whose parent
# directory is still excluded, so the directory has to be un-ignored first).
**/media/
!scripts/media/
!scripts/media/**
!**/media-lock.json
stock-sources.yaml

# Skills fetched by scripts/install-skills.mjs.
#
# Its default target is ./.claude/skills/, so running it inside this repo would otherwise
# stage four third-party projects — their code AND their licence obligations — into a repo
# that deliberately vendors none of them. Exactly what the registry exists to avoid.
#
# skills/ itself IS committed: that is the kit's own skills plus registry.json.
.claude/skills/

# Python / Node
__pycache__/
*.pyc
.venv/
.venv-vision/
node_modules/

# OS
.DS_Store
Thumbs.db

# hyperframes >= 0.9 writes per-template render/lint state here (history-id, video-state.json)
.hyperframes/

# The README's sample videos are deliberate, compressed (540p, <1 MB each) and documented in
# examples/niche-samples/README.md — the one place a rendered video.mp4 belongs in the repo.
!examples/niche-samples/*/video.mp4
