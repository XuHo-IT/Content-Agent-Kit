# ─────────────────────────────────────────────────────────────────────────────
# content-agent-kit — environment template
# Copy to `.env` and fill in. NEVER commit `.env`. Scripts are ENV-ONLY:
# there are NO hardcoded token/URL fallbacks anywhere in this kit.
# ─────────────────────────────────────────────────────────────────────────────

# --- Optional tooling ---
GITHUB_TOKEN=                  # only raises the API rate limit for scripts/install-skills.mjs
                               # and scripts/research/ (10/min -> 30/min on code search)

# --- Topic research (scripts/research/, skills topic-radar + daily-topic-video) ---
# Every source is KEYLESS: Reddit, Hacker News, GitHub and Google News all answer without
# an account, so `topic-radar` works on a fresh clone with an empty .env. Nothing below is
# required — these only change what it looks at and how it ranks.
RADAR_SOURCES=reddit,hn,github,news
RADAR_DAYS=30                  # lookback window
RADAR_TOP=10                   # how many stories to keep
RADAR_HALFLIFE_DAYS=3          # freshness decay: a 3-day-old story scores half a fresh one
RADAR_DIR=                     # default brain/radar  (the seen-ledger sits beside it)
NEWS_RSS_LOCALE=vi|VN|VN:vi    # Google News hl|gl|ceid — e.g. en|US|US:en for English
RESEARCH_USER_AGENT=           # identifies you to Reddit and Nominatim; both require one

# --- Geo flythrough (scripts/video/geo-flythrough.mjs, media source "geo") ---
# Real map + satellite + street-level imagery of one place, cross-faded into a 9:16 hook.
# FREE AND KEYLESS: stills are stitched from OpenStreetMap-derived raster tiles and
# geocoded via Nominatim. Nothing below is required and nothing here is billed.
# List the sources with: node scripts/video/geo-flythrough.mjs --sources
#
# ⚠️ ATTRIBUTION IS A LICENCE CONDITION and, unlike a Google static image, is NOT baked
#    into a tile. The script draws it onto every still and writes <clip>.credits.txt.
#    Do not crop it out. If no font is found it says so and prints what you must show.
GEO_TILE_WIDE=carto-dark       # far shots: carto-dark | carto-light | carto-voyager | osm | opentopo
GEO_TILE_CLOSE=esri-satellite  # zoom>=10: esri-satellite is the real satellite imagery
GEO_ZOOM_STEPS=3,6,11,16       # world -> region -> city -> close-up
GEO_GRID=                      # tiles per still, e.g. 3x5. Default 3x4 (@2x) / 3x5 (256px)
GEO_CLIP_SECONDS=8             # length the "geo" media source builds; scenes trim to fit
GEO_CACHE_DIR=                 # default <kit>/.cache/geo — built clips, so a re-render is free
GEO_FONT=                      # .ttf for the attribution line; system fonts autodetected

# Street level: Mapillary (crowd-sourced, CC BY-SA) in place of Street View. The token is
# free at mapillary.com. No token, or no coverage at that spot -> map stills only.
MAPILLARY_TOKEN=
GEO_STREET=3                   # how many street-level images to append; 0 = off

# --- Memes (scripts/media/lib/sources/meme.mjs, source "meme") ---
# Free and keyless. ~400 templates. Nothing below is required.
# ⚠️ MEME_FONT defaults to notosans, NOT the site's own `impact`. Impact has no Vietnamese
#    diacritics: "Viết bước đầu" renders as "VI T B C Đ U" and the API still returns 200.
#    Only change this if you are not writing Vietnamese.
MEME_API_BASE=https://api.memegen.link
MEME_FONT=notosans             # impact | notosans | titilliumweb | kalam | segoe …

# --- Social video (scripts/media/lib/sources/social.mjs, source "social") ---
# Douyin / TikTok / Bilibili / Kuaishou. The kit ships NO downloader — this points at a
# service you run yourself:
#   git clone https://github.com/Evil0ctal/Douyin_TikTok_Download_API   (Apache-2.0)
#   cd Douyin_TikTok_Download_API && docker compose up -d
# Cookies go in THAT service's crawlers/*/web/config.yaml, never in this kit.
#
# ⚠️ The clip is somebody else's work and removing a watermark does not remove a copyright.
#    Every scene using this source must declare "rights" (own | licensed | permitted |
#    public-domain); validate-script.mjs refuses without it and media-lock.json records it.
SOCIAL_API_BASE=               # e.g. http://127.0.0.1:80
SOCIAL_WATERMARK=false         # true keeps the original watermark

# --- Publish target (your site's ingest API) ---
SITE_URL=                      # e.g. https://www.example.com  (no trailing slash)
INGEST_API_TOKEN=              # Bearer token your ingest/queue API checks

# --- Crawl idea queue (optional; only if you crawl sources) ---
# Uses SITE_URL + INGEST_API_TOKEN above against /api/<queue> endpoints.
QUEUE_PATH=/api/queue          # override the queue endpoint path

# --- Media host (where local images/videos are uploaded before posting) ---
# Three hosts ship with the kit. Leave MEDIA_HOST unset and the code picks `r2`.
MEDIA_HOST=cloudinary          # r2 | cloudinary | catbox
IMAGE_HOST=                    # legacy alias, still read if MEDIA_HOST is unset
# Free-tier ceilings: Cloudinary ≈10MB image / ≈100MB video · Catbox 200MB.

# r2 — Cloudflare R2, the durable option: you own the bucket, egress is free and a
# custom domain can front it. All five are required; the kit refuses to guess any of them.
# The SigV4 signer is self-tested but the R2 wiring is not yet confirmed against a live
# bucket — run `node scripts/media/host-check.mjs` once before relying on it. See docs/15.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=                # public URL the bucket is served on, no trailing slash
R2_PREFIX=agent-media          # optional key prefix; blank uploads to the bucket root

# cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UNSIGNED_PRESET=    # unsigned upload preset (client-safe)
CLOUDINARY_FOLDER=             # optional folder, e.g. agent_posts

# catbox — anonymous, no key. Nothing guarantees the file stays there, so it suits a
# throwaway test and not a URL a social platform will fetch again later.

# --- Social webhook (Make.com / n8n / Zapier) ---
MAKE_WEBHOOK_URL=              # e.g. https://hook.eu1.make.com/xxxxxxxx
# Uploading a video is a different Make scenario from posting a photo — different modules,
# so usually a different hook. Set this and `make-post.mjs` uses it for video posts on its
# own; leave it empty and everything goes to MAKE_WEBHOOK_URL as before. Sending a video
# payload to the image hook fails silently: 200 back, nothing on the Page.
MAKE_WEBHOOK_VIDEO=            # optional; video posts only
# A Make webhook can be locked with an "API key restriction" in its settings. When it is,
# every request without the key returns 401 — an empty POST too, which is how you tell this
# apart from a detached scenario (410). Make reads it from the X-Make-ApiKey header.
# Name the variable after the webhook it unlocks; MAKE_WEBHOOK_KEY is the shared fallback.
MAKE_WEBHOOK_URL_KEY=          # optional; API key for the MAKE_WEBHOOK_URL hook
MAKE_WEBHOOK_VIDEO_KEY=        # optional; API key for the MAKE_WEBHOOK_VIDEO hook
MAKE_WEBHOOK_KEY=              # optional; used when the per-hook variable above is unset
SOCIAL_PLATFORMS=              # default targets, e.g. tiktok,youtube_shorts,facebook_reels,instagram_reels

# --- Video generation (optional; local render — see docs/14) ---
# Needs FFmpeg + ffprobe + Chrome on PATH. GitHub Actions cannot run this step.
TTS_CONCURRENCY=1              # parallel TTS calls
VIDEO_TEMPLATES_DIR=           # default <kit>/video-templates
VIDEO_SFX_DIR=                 # default <kit>/assets/sfx (absent -> render without SFX)

# Which renderer. Leave unset for the kit's own pipeline — it is free per video and needs
# no account. `node scripts/video/render.mjs --list-backends` prints what each one costs.
VIDEO_BACKEND=                 # html (default) | api | remotion
VIDEO_PROFILE=                 # personal | business — a file in profiles/, see docs/20

# api backend — Google's hosted models. THIS ONE BILLS PER SECOND OF VIDEO.
# Veo 3.1 is $0.40/s, so a 60-second video is $24 and a week of dailies is $168. The
# render prints its estimate and stops before spending; set a ceiling so it stops on its
# own rather than on your judgement at 2am.
GEMINI_API_KEY=
VIDEO_API_MODEL=veo-3.1-fast   # veo-3.1 | veo-3.1-fast | veo-3.1-lite
VIDEO_API_RESOLUTION=1080p     # 720p | 1080p | 4k
VIDEO_COST_CEILING_USD=        # refuse a render estimated above this. Empty = ask instead.

# remotion backend — scaffolds an npm project beside your script; nothing is installed
# into this kit. See docs/20-video-backends.md.
REMOTION_PROJECT_DIR=          # default <script dir>/remotion

# --- Stock footage + screenshots (optional; see docs/15) ---
# Only Pexels and Pixabay have working public APIs. Coverr/Unsplash need keys you may not
# have (and Unsplash is photos). Mixkit/Videezy/Videvo/Lifecoach have NO API — download
# those clips yourself and list them in stock-sources.yaml (source: "manual").
PEXELS_API_KEY=                # free at pexels.com/api — has portrait search, the default
                               # (PEXELS_API is accepted as an alias)
PIXABAY_API_KEY=               # free at pixabay.com/api/docs — landscape only, gets cropped
                               # (PIXABAY_API is accepted as an alias)
STOCK_SOURCE=pexels            # pexels | pixabay | manual
STOCK_MIN_DURATION=4           # skip clips shorter than this many seconds
STOCK_SOURCES_FILE=            # default <kit>/stock-sources.yaml
CHROME_PATH=                   # screenshots; auto-detected from the puppeteer cache otherwise
# Coverr and Unsplash are NOT wired up — there is no source module for either, so setting a
# key would do nothing. Listed here only so you know why: Coverr's public API is gone and
# Unsplash is photos, not footage. Add scripts/media/lib/sources/<name>.mjs to change that.

# --- Background music (scripts/video/music-search.mjs, "music" block in script.json) ---
# Openverse (WordPress Foundation CC search). NO KEY. Every request is filtered to
# license_type=commercial,modification — the licences that clear a monetised, edited video.
# Anonymous quota: 20/min burst, 200/day. Exceeding the burst answers 401, not 429, which
# reads as a credential error for an API that takes no credentials.
# ⚠️ CC0 means NOT copyright-encumbered. It does NOT mean "will not be Content-ID claimed".
MUSIC_API_BASE=https://api.openverse.org

# --- Voice / TTS provider ---
# A script.json's `voice` block overrides these, so one .env can serve many scripts.
# Only omnivoice needs a local server; every other option needs just an API key.
# List them all with: node scripts/video/tts-check.mjs --providers
TTS_PROVIDER=omnivoice         # omnivoice | elevenlabs | vbee | fptai | viettel | http
TTS_VOICE_ID=                  # required by every provider except omnivoice
TTS_SPEED=1.0                  # 0.5–2.0 (applied by the provider, or via ffmpeg if it can't)

# omnivoice — local server: POST /tts {text} -> audio/mpeg. No key.
OMNIVOICE_ENDPOINT=http://127.0.0.1:8123

# elevenlabs — TTS_VOICE_ID is the voice_id; list them with tts-check --list-voices
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2   # use a multilingual model for Vietnamese

# vbee — Vietnamese specialist; TTS_VOICE_ID is the voice_code (e.g.
# hn_female_ngochuyen_full_48k-fhg). The variable is VBEE_TOKEN, not VBEE_API_KEY: this file
# said the latter for a while and nobody could get vbee working by following it.
VBEE_TOKEN=
VBEE_APP_ID=
VBEE_ENDPOINT=                 # default https://api.vbee.vn/v1/tts
VBEE_BITRATE=128               # optional
VBEE_WEBHOOK_URL=              # optional — vbee's async API wants one; unused by this kit

# fptai — TTS_VOICE_ID is one of: banmai lannhi leminh myan thuminh giahuy linhsan
FPTAI_API_KEY=
FPTAI_ENDPOINT=

# viettel — EXPERIMENTAL (thin public docs); verify with tts-check.mjs before relying on it
VIETTEL_TOKEN=
VIETTEL_ENDPOINT=

# http — generic adapter for any provider without a built-in one (e.g. a service whose
# API you have but the kit doesn't ship). ${text} ${voiceId} ${speed} and ${ANY_ENV_VAR}
# are substituted; ${text} is JSON-escaped so Vietnamese diacritics stay intact.
TTS_HTTP_URL=
TTS_HTTP_METHOD=POST
TTS_HTTP_HEADERS=              # e.g. {"Authorization":"Bearer ${MY_TTS_KEY}"}
TTS_HTTP_BODY=                 # e.g. {"text":"${text}","voice":"${voiceId}"}
TTS_HTTP_SHAPE=bytes           # bytes = body IS the audio | asyncUrl = JSON holds a link
TTS_HTTP_AUDIO_FIELD=url       # asyncUrl only: dotted path to the link, e.g. data.url

# --- Optional: direct DB access for audit/list (Supabase example) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LIST_PATH=                     # site read endpoint; if set, used instead of Supabase
PUBLISH_TABLE=stories          # Supabase table for list-published.mjs
PUBLISH_COLS=                  # columns to select

# --- Optional: quality audit tuning (scripts/audit-quality.mjs) ---
AUDIT_MIN_WORDS=
AUDIT_BODY_FIELDS=
AUDIT_IMAGE_FIELDS=
AUDIT_TEXT_FIELDS=
AUDIT_REQUIRED_FIELDS=
AUDIT_KIND_FIELD=
AUDIT_RULES_PATH=              # .mjs exporting `export const rules = [...]`
